{
  "name": "blocksworn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blocksworn — block puzzle RPG (Vite + ES Modules scaffold)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mv dist/index.html dist/shell.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test:smoke": "playwright test tests/smoke --project=chromium --project=mobile-chrome",
    "test:smoke:full": "playwright test tests/smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual:baseline": "playwright test tests/visual/capture-baseline.spec.js --project=chromium --project=mobile-chrome",
    "test:visual": "playwright test tests/visual/regression.spec.js --project=chromium --project=mobile-chrome",
    "test:visual:ci": "playwright test tests/visual/regression.spec.js --project=chromium",
    "test:visual:update": "npm run test:visual:baseline"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.10.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.3.0",
    "lint-staged": "^17.0.4",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
